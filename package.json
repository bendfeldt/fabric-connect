{
  "name": "fabric-connect",
  "displayName": "Fabric Connect",
  "description": "Local-first Microsoft Fabric development: run notebooks, files, Spark jobs and KQL/DAX/GraphQL queries from your git repo on Fabric compute — Databricks Connect-style, and it never deploys.",
  "version": "1.4.0",
  "publisher": "bendfeldt",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/bendfeldt/fabric-connect.git"
  },
  "homepage": "https://github.com/bendfeldt/fabric-connect#readme",
  "bugs": {
    "url": "https://github.com/bendfeldt/fabric-connect/issues"
  },
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=18"
  },
  "categories": [
    "Notebooks",
    "Data Science"
  ],
  "keywords": [
    "microsoft fabric",
    "fabric",
    "spark",
    "livy",
    "lakehouse",
    "onelake",
    "notebook",
    "kql",
    "dax",
    "graphql",
    "databricks connect",
    "local-first"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B3A3F",
    "theme": "dark"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:.fabric/local.json"
  ],
  "contributes": {
    "notebooks": [
      {
        "type": "fabric-notebook",
        "displayName": "Fabric Notebook",
        "selector": [
          {
            "filenamePattern": "**/*.Notebook/notebook-content.ipynb"
          }
        ]
      },
      {
        "type": "fabric-notebook-source",
        "displayName": "Fabric Notebook (git source format)",
        "selector": [
          {
            "filenamePattern": "**/*.Notebook/notebook-content.py"
          },
          {
            "filenamePattern": "**/*.Notebook/notebook-content.scala"
          },
          {
            "filenamePattern": "**/*.Notebook/notebook-content.sql"
          },
          {
            "filenamePattern": "**/*.Notebook/notebook-content.r"
          }
        ]
      },
      {
        "type": "fabric-api-notebook",
        "displayName": "Fabric REST API Notebook",
        "selector": [
          {
            "filenamePattern": "*.fabnb"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "fabric-connect.signIn",
        "title": "Fabric: Sign In",
        "icon": "$(sign-in)"
      },
      {
        "command": "fabric-connect.switchTenant",
        "title": "Fabric: Switch Tenant",
        "icon": "$(organization)"
      },
      {
        "command": "fabric-connect.signOut",
        "title": "Fabric: Sign Out",
        "icon": "$(sign-out)"
      },
      {
        "command": "fabric-connect.accountMenu",
        "title": "Fabric: Account…"
      },
      {
        "command": "fabric-connect.openAsFabricNotebook",
        "title": "Fabric: Open File as Fabric Notebook"
      },
      {
        "command": "fabric-connect.manageLakehouses",
        "title": "Fabric: Manage Lakehouses for Active Notebook"
      },
      {
        "command": "fabric-connect.stopLivySession",
        "title": "Fabric: Stop Livy Session"
      },
      {
        "command": "fabric-connect.connectCompute",
        "title": "Fabric: Connect to Compute",
        "icon": "$(plug)"
      },
      {
        "command": "fabric-connect.disconnectCompute",
        "title": "Fabric: Disconnect from Compute",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "fabric-connect.changeHost",
        "title": "Fabric: Change Host Lakehouse…",
        "icon": "$(edit)"
      },
      {
        "command": "fabric-connect.nameCapacity",
        "title": "Fabric: Name This Capacity…",
        "icon": "$(edit)"
      },
      {
        "command": "fabric-connect.selectCapacity",
        "title": "Fabric: Connect to This Capacity",
        "icon": "$(plug)"
      },
      {
        "command": "fabric-connect.repo.refresh",
        "title": "Refresh",
        "category": "Fabric",
        "icon": "$(refresh)"
      },
      {
        "command": "fabric-connect.repo.run",
        "title": "Run on Fabric",
        "category": "Fabric",
        "icon": "$(play)"
      },
      {
        "command": "fabric-connect.repo.openPlatform",
        "title": "Open .platform",
        "category": "Fabric"
      },
      {
        "command": "fabric-connect.repo.editItemMetadata",
        "title": "Edit Item Metadata…",
        "category": "Fabric"
      },
      {
        "command": "fabric-connect.lakehouses.refresh",
        "title": "Refresh",
        "category": "Fabric",
        "icon": "$(refresh)"
      },
      {
        "command": "fabric-connect.lakehouses.attach",
        "title": "Attach to Notebook",
        "category": "Fabric",
        "icon": "$(add)"
      },
      {
        "command": "fabric-connect.lakehouses.setDefault",
        "title": "Set as Default Lakehouse",
        "category": "Fabric",
        "icon": "$(star-empty)"
      },
      {
        "command": "fabric-connect.lakehouses.detach",
        "title": "Detach from Notebook",
        "category": "Fabric",
        "icon": "$(close)"
      },
      {
        "command": "fabric-connect.bindDefaultLakehouse",
        "title": "Fabric: Bind Notebook's Default Lakehouse…",
        "icon": "$(link)"
      },
      {
        "command": "fabric-connect.unbindDefaultLakehouse",
        "title": "Fabric: Unbind Notebook's Default Lakehouse",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "fabric-connect.restartLivySession",
        "title": "Fabric: Restart Livy Session"
      },
      {
        "command": "fabric-connect.showLivySessions",
        "title": "Fabric: Show Livy Sessions"
      },
      {
        "command": "fabric-connect.pythonModules",
        "title": "Fabric: Python Modules (Local or Remote)",
        "icon": "$(edit)"
      },
      {
        "command": "fabric-connect.openAsNotebook",
        "title": "Fabric: Open as Notebook",
        "icon": "$(notebook)"
      },
      {
        "command": "fabric-connect.openAsText",
        "title": "Fabric: Open as Text",
        "icon": "$(file-code)"
      },
      {
        "command": "fabric-connect.openChangesAsText",
        "title": "Fabric: Open Changes as Text",
        "icon": "$(git-compare)"
      },
      {
        "command": "fabric-connect.runNotebookAll",
        "title": "Fabric: Run All Cells",
        "icon": "$(run-all)"
      },
      {
        "command": "fabric-connect.runNotebookCell",
        "title": "Fabric: Run Cell"
      },
      {
        "command": "fabric-connect.runNotebookCellsAbove",
        "title": "Fabric: Run All Above"
      },
      {
        "command": "fabric-connect.runFile",
        "title": "Fabric: Run File on Fabric",
        "icon": "$(play)"
      },
      {
        "command": "fabric-connect.runSelection",
        "title": "Fabric: Run Selection on Fabric"
      },
      {
        "command": "fabric-connect.runSparkJob",
        "title": "Fabric: Run Spark Job Definition"
      },
      {
        "command": "fabric-connect.runQuery",
        "title": "Fabric: Run Query File",
        "icon": "$(play)"
      },
      {
        "command": "fabric-connect.changeQueryTarget",
        "title": "Fabric: Change Query Target"
      },
      {
        "command": "fabric-connect.explorer.refresh",
        "title": "Refresh",
        "category": "Fabric",
        "icon": "$(refresh)"
      },
      {
        "command": "fabric-connect.explorer.copyId",
        "title": "Copy ID",
        "category": "Fabric"
      },
      {
        "command": "fabric-connect.explorer.copyName",
        "title": "Copy Name",
        "category": "Fabric"
      },
      {
        "command": "fabric-connect.explorer.copyOneLakePath",
        "title": "Copy OneLake Path",
        "category": "Fabric"
      },
      {
        "command": "fabric-connect.explorer.copySqlConnectionString",
        "title": "Copy SQL Connection String",
        "category": "Fabric"
      },
      {
        "command": "fabric-connect.explorer.previewTable",
        "title": "Preview Table",
        "category": "Fabric",
        "icon": "$(table)"
      },
      {
        "command": "fabric-connect.explorer.previewFile",
        "title": "Preview File",
        "category": "Fabric",
        "icon": "$(preview)"
      },
      {
        "command": "fabric-connect.explorer.pullItem",
        "title": "Pull into Repo…",
        "category": "Fabric",
        "icon": "$(cloud-download)"
      },
      {
        "command": "fabric-connect.explorer.openInFabric",
        "title": "Open in Fabric",
        "category": "Fabric",
        "icon": "$(link-external)"
      },
      {
        "command": "fabric-connect.newApiNotebook",
        "title": "Fabric: New API Notebook"
      }
    ],
    "configuration": {
      "title": "Fabric Connect",
      "properties": {
        "fabric-connect.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log redacted Fabric API requests/responses to the 'Fabric Connect' output channel."
        },
        "fabric-connect.sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace-relative folders whose Python modules are staged to the Spark session before Python code runs, so `import` uses your working tree (e.g. [\"src\"]). When empty, Local mode uses the folders pyproject.toml names, else `src`."
        },
        "fabric-connect.pythonModules": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "remote"
          ],
          "enumDescriptions": [
            "Local when 'fabric-connect.sourceRoots' is set, otherwise Remote.",
            "Import your working tree: its packages are staged to the session before Python code runs.",
            "Import what the Fabric environment has installed (e.g. your published wheel). Nothing is staged."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Where Python `import` finds your packages. Change it with 'Fabric: Python Modules' or the status bar."
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "fabric-connect.runNotebookAll",
          "when": "activeEditor == workbench.editors.files.textFileEditor && resourcePath =~ /\\.Notebook[\\\\/]notebook-content\\.(py|sql|scala|r)$/",
          "group": "fabric"
        },
        {
          "command": "fabric-connect.runFile",
          "when": "(resourceLangId == python || resourceLangId == sql || resourceLangId == scala || resourceLangId == r) && !(resourcePath =~ /\\.Notebook[\\\\/]notebook-content\\.(py|sql|scala|r)$/)",
          "group": "fabric"
        },
        {
          "command": "fabric-connect.runQuery",
          "when": "resourceExtname == .kql || resourceExtname == .csl || resourceExtname == .dax || resourceExtname == .graphql || resourceExtname == .gql",
          "group": "fabric"
        }
      ],
      "editor/context": [
        {
          "command": "fabric-connect.runSelection",
          "when": "editorHasSelection && (resourceLangId == python || resourceLangId == sql || resourceLangId == scala || resourceLangId == r)",
          "group": "fabric"
        }
      ],
      "explorer/context": [
        {
          "command": "fabric-connect.runFile",
          "when": "!explorerResourceIsFolder && (resourceLangId == python || resourceLangId == sql || resourceLangId == scala || resourceLangId == r)",
          "group": "fabric"
        },
        {
          "command": "fabric-connect.runSparkJob",
          "when": "explorerResourceIsFolder && resourceFilename =~ /\\.SparkJobDefinition$/",
          "group": "fabric"
        }
      ],
      "commandPalette": [
        {
          "command": "fabric-connect.explorer.copyId",
          "when": "false"
        },
        {
          "command": "fabric-connect.explorer.copyName",
          "when": "false"
        },
        {
          "command": "fabric-connect.explorer.copyOneLakePath",
          "when": "false"
        },
        {
          "command": "fabric-connect.explorer.copySqlConnectionString",
          "when": "false"
        },
        {
          "command": "fabric-connect.explorer.previewTable",
          "when": "false"
        },
        {
          "command": "fabric-connect.explorer.previewFile",
          "when": "false"
        },
        {
          "command": "fabric-connect.explorer.pullItem",
          "when": "false"
        },
        {
          "command": "fabric-connect.explorer.openInFabric",
          "when": "false"
        },
        {
          "command": "fabric-connect.repo.run",
          "when": "false"
        },
        {
          "command": "fabric-connect.repo.refresh",
          "when": "false"
        },
        {
          "command": "fabric-connect.repo.openPlatform",
          "when": "false"
        },
        {
          "command": "fabric-connect.repo.editItemMetadata",
          "when": "false"
        },
        {
          "command": "fabric-connect.lakehouses.refresh",
          "when": "false"
        },
        {
          "command": "fabric-connect.lakehouses.attach",
          "when": "false"
        },
        {
          "command": "fabric-connect.lakehouses.setDefault",
          "when": "false"
        },
        {
          "command": "fabric-connect.lakehouses.detach",
          "when": "false"
        },
        {
          "command": "fabric-connect.bindDefaultLakehouse",
          "when": "notebookType == fabric-notebook || notebookType == fabric-notebook-source"
        },
        {
          "command": "fabric-connect.unbindDefaultLakehouse",
          "when": "false"
        },
        {
          "command": "fabric-connect.runNotebookCell",
          "when": "false"
        },
        {
          "command": "fabric-connect.runNotebookCellsAbove",
          "when": "false"
        },
        {
          "command": "fabric-connect.runNotebookAll",
          "when": "activeEditor == workbench.editors.files.textFileEditor && resourcePath =~ /\\.Notebook[\\\\/]notebook-content\\.(py|sql|scala|r)$/"
        },
        {
          "command": "fabric-connect.openAsNotebook",
          "when": "activeEditor == workbench.editors.files.textFileEditor && resourcePath =~ /\\.Notebook[\\\\/]notebook-content\\.(py|sql|scala|r|ipynb)$/"
        },
        {
          "command": "fabric-connect.openAsText",
          "when": "activeEditor == workbench.editor.notebook && (notebookType == fabric-notebook-source || notebookType == fabric-notebook)"
        },
        {
          "command": "fabric-connect.openChangesAsText",
          "when": "resourcePath =~ /\\.Notebook[\\\\/]notebook-content\\.(py|sql|scala|r|ipynb)$/"
        }
      ],
      "view/title": [
        {
          "command": "fabric-connect.explorer.refresh",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/",
          "group": "navigation"
        },
        {
          "command": "fabric-connect.repo.refresh",
          "when": "view == fabricConnect.repo",
          "group": "navigation"
        },
        {
          "command": "fabric-connect.lakehouses.refresh",
          "when": "view == fabricConnect.lakehouses",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fabric-connect.selectCapacity",
          "when": "view == fabricConnect.explorer && viewItem == fabricCapacity",
          "group": "inline"
        },
        {
          "command": "fabric-connect.selectCapacity",
          "when": "view == fabricConnect.explorer && viewItem =~ /fabricCapacity|onCapacity/",
          "group": "0_select"
        },
        {
          "command": "fabric-connect.explorer.pullItem",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/ && viewItem =~ /fabricItem/",
          "group": "1_pull"
        },
        {
          "command": "fabric-connect.explorer.copySqlConnectionString",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/ && viewItem =~ /\\bsql\\b/",
          "group": "2_copy"
        },
        {
          "command": "fabric-connect.explorer.copyId",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/ && viewItem =~ /fabric(Item|Workspace|Capacity|Connection)/",
          "group": "2_copy"
        },
        {
          "command": "fabric-connect.explorer.copyName",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/ && viewItem =~ /fabric/",
          "group": "2_copy"
        },
        {
          "command": "fabric-connect.explorer.copyOneLakePath",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/ && viewItem =~ /fabric(Table|Folder|File|Item)/",
          "group": "2_copy"
        },
        {
          "command": "fabric-connect.explorer.previewTable",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/ && viewItem == fabricTable",
          "group": "inline"
        },
        {
          "command": "fabric-connect.explorer.previewTable",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/ && viewItem == fabricTable",
          "group": "0_preview"
        },
        {
          "command": "fabric-connect.explorer.previewFile",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/ && viewItem == fabricFile",
          "group": "0_preview"
        },
        {
          "command": "fabric-connect.explorer.openInFabric",
          "when": "view =~ /^fabricConnect\\.(explorer|connections)$/ && viewItem =~ /fabric(Item|Workspace)/",
          "group": "3_open"
        },
        {
          "command": "fabric-connect.signIn",
          "when": "view == fabricConnect.configuration && viewItem =~ /fabricConfigAccount/",
          "group": "inline@1"
        },
        {
          "command": "fabric-connect.signOut",
          "when": "view == fabricConnect.configuration && viewItem =~ /fabricConfigAccount/",
          "group": "inline@2"
        },
        {
          "command": "fabric-connect.switchTenant",
          "when": "view == fabricConnect.configuration && viewItem =~ /fabricConfigTenant/",
          "group": "inline"
        },
        {
          "command": "fabric-connect.connectCompute",
          "when": "view == fabricConnect.configuration && viewItem =~ /fabricConfigCompute/",
          "group": "inline@1"
        },
        {
          "command": "fabric-connect.disconnectCompute",
          "when": "view == fabricConnect.configuration && viewItem =~ /\\bconnected\\b/",
          "group": "inline@2"
        },
        {
          "command": "fabric-connect.repo.run",
          "when": "view == fabricConnect.repo && viewItem =~ /\\brunnable\\b/",
          "group": "inline"
        },
        {
          "command": "fabric-connect.repo.run",
          "when": "view == fabricConnect.repo && viewItem =~ /\\brunnable\\b/",
          "group": "0_run"
        },
        {
          "command": "fabric-connect.repo.openPlatform",
          "when": "view == fabricConnect.repo && viewItem =~ /fabricRepoItem/",
          "group": "1_platform@1"
        },
        {
          "command": "fabric-connect.repo.editItemMetadata",
          "when": "view == fabricConnect.repo && viewItem =~ /fabricRepoItem/",
          "group": "1_platform@2"
        },
        {
          "command": "fabric-connect.lakehouses.attach",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricLakehouse",
          "group": "inline@1"
        },
        {
          "command": "fabric-connect.lakehouses.setDefault",
          "when": "view == fabricConnect.lakehouses && viewItem =~ /^fabricLakehouse\\b/ && viewItem !~ /\\bdefault\\b/",
          "group": "inline@2"
        },
        {
          "command": "fabric-connect.lakehouses.detach",
          "when": "view == fabricConnect.lakehouses && viewItem =~ /\\battached\\b/",
          "group": "inline@3"
        },
        {
          "command": "fabric-connect.lakehouses.attach",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricLakehouse",
          "group": "0_attach@1"
        },
        {
          "command": "fabric-connect.lakehouses.setDefault",
          "when": "view == fabricConnect.lakehouses && viewItem =~ /^fabricLakehouse\\b/ && viewItem !~ /\\bdefault\\b/",
          "group": "0_attach@2"
        },
        {
          "command": "fabric-connect.lakehouses.detach",
          "when": "view == fabricConnect.lakehouses && viewItem =~ /\\battached\\b/",
          "group": "0_attach@3"
        },
        {
          "command": "fabric-connect.changeHost",
          "when": "view == fabricConnect.configuration && viewItem == fabricConfigHost",
          "group": "inline"
        },
        {
          "command": "fabric-connect.pythonModules",
          "when": "view == fabricConnect.configuration && viewItem == fabricConfigModules",
          "group": "inline"
        },
        {
          "command": "fabric-connect.nameCapacity",
          "when": "view == fabricConnect.configuration && viewItem == fabricConfigCapacity",
          "group": "inline"
        },
        {
          "command": "fabric-connect.bindDefaultLakehouse",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricUnboundLakehouse",
          "group": "inline"
        },
        {
          "command": "fabric-connect.bindDefaultLakehouse",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricUnboundLakehouse",
          "group": "0_bind"
        },
        {
          "command": "fabric-connect.unbindDefaultLakehouse",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricBoundLakehouse",
          "group": "inline"
        },
        {
          "command": "fabric-connect.bindDefaultLakehouse",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricBoundLakehouse",
          "group": "0_bind@1"
        },
        {
          "command": "fabric-connect.unbindDefaultLakehouse",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricBoundLakehouse",
          "group": "0_bind@2"
        },
        {
          "command": "fabric-connect.explorer.previewTable",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricTable",
          "group": "inline"
        },
        {
          "command": "fabric-connect.explorer.previewTable",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricTable",
          "group": "0_preview"
        },
        {
          "command": "fabric-connect.explorer.previewFile",
          "when": "view == fabricConnect.lakehouses && viewItem == fabricFile",
          "group": "0_preview"
        },
        {
          "command": "fabric-connect.explorer.copyOneLakePath",
          "when": "view == fabricConnect.lakehouses && viewItem =~ /^fabric(Table|Folder|File)$/",
          "group": "2_copy"
        }
      ],
      "editor/title": [
        {
          "command": "fabric-connect.openAsNotebook",
          "when": "activeEditor == workbench.editors.files.textFileEditor && resourcePath =~ /\\.Notebook[\\\\/]notebook-content\\.(py|sql|scala|r|ipynb)$/",
          "group": "navigation"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "fabric-connect.openAsText",
          "when": "notebookType == fabric-notebook-source || notebookType == fabric-notebook",
          "group": "navigation/fabric"
        },
        {
          "command": "fabric-connect.openChangesAsText",
          "when": "notebookType == fabric-notebook-source || notebookType == fabric-notebook",
          "group": "fabric"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "fabric-connect.openChangesAsText",
          "when": "scmProvider == git && resourcePath =~ /\\.Notebook[\\\\/]notebook-content\\.(py|sql|scala|r|ipynb)$/",
          "group": "inline"
        },
        {
          "command": "fabric-connect.openChangesAsText",
          "when": "scmProvider == git && resourcePath =~ /\\.Notebook[\\\\/]notebook-content\\.(py|sql|scala|r|ipynb)$/",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "kql",
        "aliases": [
          "KQL",
          "Kusto"
        ],
        "extensions": [
          ".kql",
          ".csl"
        ]
      },
      {
        "id": "dax",
        "aliases": [
          "DAX"
        ],
        "extensions": [
          ".dax"
        ]
      },
      {
        "id": "graphql",
        "aliases": [
          "GraphQL"
        ],
        "extensions": [
          ".graphql",
          ".gql"
        ]
      },
      {
        "id": "fabric-api",
        "aliases": [
          "Fabric API"
        ]
      },
      {
        "id": "json",
        "filenames": [
          ".platform"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fabric-connect",
          "title": "Fabric",
          "icon": "media/fabric-activity.svg"
        }
      ]
    },
    "views": {
      "fabric-connect": [
        {
          "id": "fabricConnect.configuration",
          "name": "Configuration"
        },
        {
          "id": "fabricConnect.repo",
          "name": "Repo"
        },
        {
          "id": "fabricConnect.lakehouses",
          "name": "Lakehouses"
        },
        {
          "id": "fabricConnect.connections",
          "name": "Connections",
          "visibility": "collapsed"
        }
      ],
      "explorer": [
        {
          "id": "fabricConnect.explorer",
          "name": "Fabric"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fabricConnect.configuration",
        "contents": "Sign in with your Microsoft account to connect this repo to Fabric.\n[Sign In](command:fabric-connect.signIn)"
      },
      {
        "view": "fabricConnect.repo",
        "contents": "Open your repo folder to see its Fabric items and run them on Fabric compute.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "fabricConnect.repo",
        "contents": "No Fabric items in this folder. Items are folders with a .platform file, such as Bronze.Notebook/.\n[Show the Fabric view](command:fabricConnect.explorer.focus) to pull one into the repo.",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Fabric Connect",
        "description": "Connect your repo to Fabric compute once, then run notebooks, files, jobs and queries from VS Code. Nothing is ever deployed.",
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in with your Microsoft account",
            "description": "Sign in once per repo and pick the tenant; the account and tenant are remembered in your gitignored .fabric/local.json and reused silently next time.\n[Sign In](command:fabric-connect.signIn?%5B%22walkthrough%22%5D)",
            "media": {
              "markdown": "media/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onContext:fabricConnect.signedIn"
            ]
          },
          {
            "id": "connectCompute",
            "title": "Connect this repo to Fabric compute",
            "description": "Pick the capacity (SKU) your code runs on. A host Lakehouse for code without its own is asked when first needed. Saved in your gitignored .fabric/local.json.\n[Connect to Compute](command:fabric-connect.connectCompute?%5B%22walkthrough%22%5D)",
            "media": {
              "markdown": "media/walkthrough/connect-compute.md"
            },
            "completionEvents": [
              "onContext:fabricConnect.computeConnected"
            ]
          },
          {
            "id": "notebooks",
            "title": "Open and run a Fabric notebook",
            "description": "Fabric item notebooks open in the notebook editor; cells run on Lakehouse-hosted Spark. Bind an unbound git default locally without editing notebook metadata.\n[Open a notebook file](command:fabric-connect.openAsFabricNotebook)",
            "media": {
              "markdown": "media/walkthrough/notebooks.md"
            },
            "completionEvents": [
              "onCommand:fabric-connect.openAsFabricNotebook"
            ]
          },
          {
            "id": "runFiles",
            "title": "Run local files and your own modules",
            "description": "Run a .py/.sql/.scala/.r file or selection on Fabric. Choose Local or Remote Python modules; auto uses Local when explicit source roots are set.\n[Python module mode](command:fabric-connect.pythonModules)\n[Set source roots](command:workbench.action.openSettings?%5B%22fabric-connect.sourceRoots%22%5D)",
            "media": {
              "markdown": "media/walkthrough/run-files.md"
            },
            "completionEvents": [
              "onSettingChanged:fabric-connect.sourceRoots",
              "onCommand:fabric-connect.runFile"
            ]
          },
          {
            "id": "queries",
            "title": "Run KQL, DAX and GraphQL files",
            "description": "Keep queries in your repo and run them against an existing KQL database, semantic model or GraphQL API.\n[Run Query File](command:fabric-connect.runQuery)",
            "media": {
              "markdown": "media/walkthrough/queries.md"
            },
            "completionEvents": [
              "onCommand:fabric-connect.runQuery"
            ]
          },
          {
            "id": "explore",
            "title": "Browse Fabric (read-only)",
            "description": "The Fabric view in the Explorer side bar lists capacities, workspaces, items, OneLake files and connections — preview tables, pull items into the repo.\n[Show the Fabric view](command:fabricConnect.explorer.focus)",
            "media": {
              "markdown": "media/walkthrough/explorer.md"
            },
            "completionEvents": [
              "onView:fabricConnect.explorer"
            ]
          }
        ]
      }
    ],
    "configurationDefaults": {
      "workbench.editor.customLabels.patterns": {
        "**/*.Notebook/notebook-content.*": "${dirname}"
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run clean && tsc -p ./ && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run clean && npm run compile",
    "package": "npx --yes @vscode/vsce@4.0.0 package",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.93.0",
    "prettier": "3.8.5",
    "typescript": "^5.4.0"
  }
}
